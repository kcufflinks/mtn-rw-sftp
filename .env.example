# Zoho Analytics OAuth2
# Region: us (default), com, eu, in, au, jp, uk, ca, sa — must match where your org was created
ZOHO_DATA_CENTER=us
# Optional overrides if your DC is non-standard: full base URLs, no trailing slash
# ZOHO_ACCOUNTS_BASE_URL=
# ZOHO_ANALYTICS_BASE_URL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_WORKSPACE_ID=

# Zoho export SQL -- the SELECT queries to run (both exported every run)
ZOHO_SQL_QUERY=select * from "YourTableName"
ZOHO_SQL_QUERY_2=select * from "YourOtherTableName"
# Optional: filename prefixes (defaults: mtn_rw_contracts, mtn_rw_payins)
# ZOHO_EXPORT_1_FILENAME_PREFIX=mtn_rw_contracts
# ZOHO_EXPORT_2_FILENAME_PREFIX=mtn_rw_payins

# SFTP
SFTP_HOST=
SFTP_PORT=
SFTP_USERNAME=
SFTP_PASSWORD=
# Use `upload` for Docker atmoz/sftp; production path from your MTN SFTP admin
SFTP_REMOTE_DIR=Yellowdata

# Google Chat webhook URL (create in space > Apps & integrations > Webhooks)
GCHAT_WEBHOOK_URL=
