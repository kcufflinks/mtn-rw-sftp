# Zoho Analytics OAuth2
# Region: us (default), com, eu, in, au, jp, uk, ca, sa — must match where your org was created
ZOHO_DATA_CENTER=us
# Optional overrides if your DC is non-standard: full base URLs, no trailing slash
# ZOHO_ACCOUNTS_BASE_URL=
# ZOHO_ANALYTICS_BASE_URL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_WORKSPACE_ID=

# Zoho export SQL -- the SELECT query to run
ZOHO_SQL_QUERY=select * from "YourTableName"

# SFTP
SFTP_HOST=
SFTP_PORT=
SFTP_USERNAME=
SFTP_PASSWORD=
# Use `upload` for Docker atmoz/sftp; production path from your MTN SFTP admin
SFTP_REMOTE_DIR=/

# Gmail SMTP
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_RECIPIENTS=alice@example.com,bob@example.com
# Optional: comma-separated CC addresses (same Gmail sending limits)
EMAIL_CC=
